# Application Environment Configuration
APP_NAME=Aptitude Practice Assistant API
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite Database
DATABASE_URL=sqlite:///./aptitude_assistant.db

# Groq LLM API Configuration (Get your free key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
